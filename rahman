#!/data/data/com.termux/files/usr/bin/bash

BASE="$HOME/RahmanCLI"

COMMAND="$1"

shift


if [ -z "$COMMAND" ]; then
    COMMAND="help"
fi


# Load Theme
if [ -f "$BASE/lib/theme.sh" ]; then
    source "$BASE/lib/theme.sh"
    
    if command -v color >/dev/null 2>&1; then
        color
    fi
fi


# Load Alias System
if [ -f "$BASE/lib/alias.sh" ]; then
    source "$BASE/lib/alias.sh"
    
    if command -v resolve_alias >/dev/null 2>&1; then
        COMMAND=$(resolve_alias "$COMMAND")
    fi
fi



# Search Commands
COMMAND_FILE="$BASE/commands/$COMMAND.sh"

if [ -f "$COMMAND_FILE" ]; then

    bash "$COMMAND_FILE" "$@"

    if command -v reset_color >/dev/null 2>&1; then
        reset_color
    fi

    exit 0

fi



# Search Plugins
PLUGIN_FILE="$BASE/plugins/$COMMAND.sh"

if [ -f "$PLUGIN_FILE" ]; then

    bash "$PLUGIN_FILE" "$@"

    if command -v reset_color >/dev/null 2>&1; then
        reset_color
    fi

    exit 0

fi



# Search Extensions
EXTENSION_FILE="$BASE/extensions/$COMMAND/command.sh"

if [ -f "$EXTENSION_FILE" ]; then

    bash "$EXTENSION_FILE" "$@"

    if command -v reset_color >/dev/null 2>&1; then
        reset_color
    fi

    exit 0

fi



echo "================================"
echo "        🚀 Rahman CLI"
echo "================================"

echo "Unknown command: $COMMAND"

echo ""

echo "Run: rahman help"

echo "================================"



if command -v reset_color >/dev/null 2>&1; then
    reset_color
fi

exit 1
